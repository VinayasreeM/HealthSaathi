# Required for src/services/geminiService.js
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/healthsaathi

# Twilio WhatsApp configuration (Optional for outbound REST API messages)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

